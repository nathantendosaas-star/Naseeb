{
  "rules": {
    "inquiries": {
      ".read": "auth != null && (auth.token.email == 'nathan@masembe.com' || auth.token.email == 'nathantendo.saas@gmail.com')",
      "$inquiryId": {
        ".write": "!data.exists() || (auth != null && (auth.token.email == 'nathan@masembe.com' || auth.token.email == 'nathantendo.saas@gmail.com'))",
        ".validate": "newData.hasChildren(['firstName', 'lastName', 'email', 'phone', 'message', 'createdAt', 'status'])"
      }
    },
    "analytics": {
      ".read": "auth != null && (auth.token.email == 'nathan@masembe.com' || auth.token.email == 'nathantendo.saas@gmail.com')",
      "visits": {
        ".write": "true",
        "$date": {
          "$visitId": {
            ".validate": "newData.hasChildren(['path', 'timestamp', 'userAgent', 'referrer'])"
          }
        }
      }
    }
  }
}
